      "type": "frame",
      "id": "OT6Lk",
      "x": 1734,
      "y": 0,
      "name": "Notes",
      "theme": {
        "mode": "light"
      },
      "width": 820,
      "fill": "$window-bg",
      "cornerRadius": 16,
      "stroke": "$separator",
      "strokeWidth": 1,
      "layout": "vertical",
      "gap": 14,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "UrOrQ",
          "name": "Draft for step 6 · notes",
          "fill": "$label",
          "content": "Draft for step 6 · notes",
          "fontFamily": "$font",
          "fontSize": 17,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "blrpx",
          "name": "All screens use sample data. L",
          "fill": "$secondary-label",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "All screens use sample data. Long screens show their full height. In the app they scroll. Each dark row shows the screens above it in dark mode.",
          "fontFamily": "$font",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "c1ZIwk",
          "name": "New work in nexusd for step 6",
          "fill": "$label",
          "content": "New work in nexusd for step 6",
          "fontFamily": "$font",
          "fontSize": 13,
          "fontWeight": "600"
        },
        {
          "type": "frame",
          "id": "Kg7fK",
          "name": "List New work in nexusd for step 6",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 5,
          "children": [
            {
              "type": "text",
              "id": "tHxw2",
              "name": "•  Site groups, the order of g",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Site groups, the order of groups and sites, and \"Sort by name\".",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "K2kxv",
              "name": "•  Watch each parked folder. A",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Watch each parked folder. A new folder in it becomes a site with the defaults, without the app.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "IcwU6",
              "name": "•  List the databases in an in",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  List the databases in an instance, with their size. List the databases on the source server of an import.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "rEk79",
              "name": "•  Progress and stop for an im",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Progress and stop for an import, a package download and a workspace setup.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "nV68s",
              "name": "•  Change the account of an in",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Change the account of an instance. A new instance gets root without a password.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "NpEoh",
              "name": "•  Name the program that holds",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Name the program that holds a port (app, process, number and path), and quit that app.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "eDXu3",
              "name": "•  Tell if the root CA is trus",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Tell if the root CA is trusted. Change the dev domain after the first run.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "Yc0kU",
              "name": "•  The end date of security fi",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  The end date of security fixes and the LTS flag for each package (new fields in the manifest).",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "X9Mgzh",
              "name": "•  Tell the app about changes,",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Tell the app about changes, so the app does not ask for the status again and again.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "YbQjb",
              "name": "•  Restart a service in one st",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Restart a service in one step. Stop all services, and start again only the ones that ran before.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "bzNhh",
              "name": "•  Custom php.ini lines for ea",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Custom php.ini lines for each PHP version: check, save, restart, and keep the old lines on an error.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "HC8iU",
              "name": "•  Defaults for new sites, the",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Defaults for new sites (Settings > Sites). The app finds the terminal apps, code editors and database apps on this Mac, and the user can add one.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "auDeW",
              "name": "Dock",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  The app shows its icon in the Dock, in the menu bar or in both (Settings > General).",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "EbaxY",
              "name": "CLI page",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  The command line page lists the nexus commands with a copy button.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "text",
          "id": "b2zK9",
          "name": "Decisions that change (I updat",
          "fill": "$label",
          "content": "Decisions that change (I update docs/decisions.md)",
          "fontFamily": "$font",
          "fontSize": 13,
          "fontWeight": "600"
        },
        {
          "type": "frame",
          "id": "AOasP",
          "name": "List Decisions that change (I update docs/decisions.md)",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 5,
          "children": [
            {
              "type": "text",
              "id": "osj0X",
              "name": "•  D35: a new instance gets ro",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  D35: a new instance gets root without a password. The MAMP PRO import sets root/root on the instances that it fills.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "XlMUf",
              "name": "•  D36: Open uses the mysql://",
