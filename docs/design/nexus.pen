    {
      "type": "frame",
      "id": "oLmYo",
      "x": 2674,
      "y": 0,
      "name": "UX Rules",
      "theme": {
        "mode": "light"
      },
      "width": 820,
      "fill": "$window-bg",
      "cornerRadius": 16,
      "stroke": "$separator",
      "strokeWidth": 1,
      "layout": "vertical",
      "gap": 14,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "RFcZu",
          "name": "UX rules for every screen",
          "fill": "$label",
          "content": "UX rules for every screen",
          "fontFamily": "$font",
          "fontSize": 17,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "jO8RO",
          "name": "Words and capitals (Apple Huma",
          "fill": "$label",
          "content": "Words and capitals",
          "fontFamily": "$font",
          "fontSize": 13,
          "fontWeight": "600"
        },
        {
          "type": "frame",
          "id": "vWXa5",
          "name": "List Words and capitals (Apple Human Interface Guidelines)",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 5,
          "children": [
            {
              "type": "text",
              "id": "drqhQ",
              "name": "•  Title Case: window titles, ",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Sentence case everywhere: window titles, page titles, sidebar items, section headers, tabs, buttons, menu items and labels. Only the first word gets a capital letter. Example: \"Background processes\", \"Choose another app…\".",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "W24Rt",
              "name": "•  Sentence case: row labels, ",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Names keep their capitals: apps (Finder, Macterm, PhpStorm), products (MySQL, PHP, Composer), macOS places (Login Items, Keychain Access) and Nexus Root CA. Abbreviations stay in capitals: URL, PATH, DNS, HTTPS.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "IdW57",
              "name": "•  \"…\" at the end of a button ",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  \"…\" at the end of a button or menu item: Nexus first asks for more input or a confirmation in a sheet or alert. Without \"…\", the action happens at once. Example: \"Remove site…\" asks first, \"Copy URL\" copies at once.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "O7I0v",
              "name": "•  \"webserver\" is one word. Us",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  \"webserver\" is one word. Use the name of the app that the user chose: \"Open in Macterm\", \"Open in PhpStorm\".",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "text",
          "id": "aMdHG",
          "name": "Where actions go",
          "fill": "$label",
          "content": "Where actions go",
          "fontFamily": "$font",
          "fontSize": 13,
          "fontWeight": "600"
        },
        {
          "type": "frame",
          "id": "c9ywI9",
          "name": "List Where actions go",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 5,
          "children": [
            {
              "type": "text",
              "id": "l5itpt",
              "name": "•  The toolbar holds the actio",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  The toolbar holds the actions for the item on the screen: at most two labeled buttons and one \"…\" menu at the right.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "KSORr",
              "name": "•  The \"…\" menu holds the othe",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  The \"…\" menu holds the other actions. Remove is always the last item, in red, and asks for a confirmation.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "KWtNp",
              "name": "•  A right-click on an item in",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  A right-click on an item in the sidebar shows the same actions as its \"…\" menu.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "wDOow",
              "name": "•  The + menu at the bottom of",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  The + menu at the bottom of the sidebar adds sites, folders of projects and groups.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "Gi5oR",
              "name": "•  No buttons at the bottom of",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  No buttons at the bottom of a screen. Sheets and alerts have their buttons at the bottom right.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "text",
          "id": "LYyYU",
          "name": "Rows, text and values",
          "fill": "$label",
          "content": "Rows, text and values",
          "fontFamily": "$font",
          "fontSize": 13,
          "fontWeight": "600"
        },
        {
          "type": "frame",
          "id": "KXPiZ",
          "name": "List Rows, text and values",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 5,
          "children": [
            {
              "type": "text",
              "id": "SLujK",
              "name": "•  A row in a group is 36 pt h",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  A row in a group is 36 pt high and has one line. Help text goes in the footer under the group.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "o6FbgX",
              "name": "•  Text that does not fit ends",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Text that does not fit ends with \"…\". A path is shortened in the middle. The full text shows in a tooltip.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "DDwN0",
              "name": "•  A number field is narrow an",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  A number field is narrow and its number is on the right. In a form where all fields have the same width (Import a database), all values start on the left.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "iLOLs",
              "name": "•  A list of commands or keys ",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  A list of commands or keys has + and − at the bottom right of the list.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "MzvtH",
              "name": "•  A module or extension has a",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  A module or extension has an ⓘ after its name. Hold the pointer over the name or the ⓘ, and a tooltip shows what it does. A click on the name or the ⓘ shows the same text at once.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "yYodv",
              "name": "•  A log shows the newest 100 ",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  A log shows the newest 100 lines. Open log file opens the full log in the default app for logs.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "text",
          "id": "aY7H9",
          "name": "Controls",
          "fill": "$label",
          "content": "Controls",
          "fontFamily": "$font",
          "fontSize": 13,
          "fontWeight": "600"
        },
        {
          "type": "frame",
          "id": "BU4rh",
          "name": "List Controls",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 5,
          "children": [
            {
              "type": "text",
              "id": "cjxsJ",
              "name": "•  A switch starts or stops a ",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  A switch starts or stops a service, and turns a setting on or off. Running = on.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "EILV7",
              "name": "•  A button with text for an a",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  A button with text for an action in a row. A pop-up button for a choice. A text field for a value that you type.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "JjGEz",
              "name": "•  \"Open\" for a database is a ",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  \"Open\" for a database is a split button. A click opens the default app. The arrow shows the installed apps that can open it, and \"Copy URL\".",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "text",
          "id": "m5MepF",
          "name": "Colors and modes",
          "fill": "$label",
          "content": "Colors and modes",
          "fontFamily": "$font",
          "fontSize": 13,
          "fontWeight": "600"
        },
        {
          "type": "frame",
          "id": "DzpWO",
          "name": "List Colors and modes",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 5,
          "children": [
            {
              "type": "text",
              "id": "hHWcu",
              "name": "•  Green dot: running. Gray do",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Green dot: running. Gray dot: stopped. Orange dot: needs attention. Red dot: failed.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "FMSbC",
              "name": "•  Every color is a pair: one ",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Every color is a pair: one value for light mode and one for dark mode. Orange and red text are darker in light mode and lighter in dark mode.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "zZSyc",
              "name": "•  Purple is only for selectio",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  Purple is only for selection, links, icons, switches and the main button.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "text",
          "id": "GlT7l",
          "name": "Window",
          "fill": "$label",
          "content": "Window",
          "fontFamily": "$font",
          "fontSize": 13,
          "fontWeight": "600"
        },
        {
          "type": "frame",
          "id": "cRMDr",
          "name": "List Window",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 5,
          "children": [
            {
              "type": "text",
              "id": "Hc9cP",
              "name": "•  The main window has a minim",
              "fill": "$label",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "•  The main window has a minimum size of 900 × 600 pt. At a small height, the sidebar list scrolls and the + bar stays at the bottom.",
              "fontFamily": "$font",
              "fontSize": 12,
              "fontWeight": "normal"
            }
          ]
        }
      ]
